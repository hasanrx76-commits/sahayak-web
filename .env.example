# Firebase config (paste values from Firebase Console → Project Settings → Your apps → Web)
# Copy this file to .env.local for local dev, or set these in Vercel project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- AI Chat backend (server-side, keep secret) ----
# Any ONE of these is enough:
# Groq (recommended, free, no credit card): https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (free from aistudio.google.com)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
